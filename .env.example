# ---------------------------------------------------------------------------
# Chatbot de pre-revisión de seguridad — Banco Andesur (caso ficticio)
# Copia este archivo como ".env" y rellena LLM_API_KEY y LLM_MODEL.
# Sin clave el servidor arranca igual, en modo demo (responde FAQ y muestra los
# lineamientos recuperados, pero no redacta hallazgos).
# Nunca subas el .env al repositorio: ya está en .gitignore.
# ---------------------------------------------------------------------------

# --- Modelo (OpenAI, gama media o alta, con function calling) ---------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Modelo recomendado: gpt-6.2-sol (gama media-alta de OpenAI, con razonamiento y
# function calling en Chat Completions; USD 2 / 10 por millón de tokens de
# entrada / salida, unos USD 0,10-0,15 por revisión completa).
# Más capaz y ~4-5 veces más caro: gpt-6.2-astra. No sirven aquí: gpt-6.1-sol y
# gpt-6.1-terra (herramientas solo por la API Responses) ni gpt-6-luna/gpt-6-sol
# (herramientas solo sin razonamiento).
LLM_MODEL=gpt-6.2-sol
# Protocolo: auto | openai | anthropic | gemini (auto lo deduce de la URL)
LLM_FAMILY=auto
# Razonamiento: auto (= medium) | off | low | medium | high
# low responde más rápido; medium razona mejor los riesgos avanzados (dinero, terceros).
LLM_REASONING=auto
# Function calling: auto | tools | prompt | ninguno
LLM_TOOLS_MODE=auto
# Segundos por llamada: con razonamiento, una revisión larga puede tardar.
LLM_TIMEOUT=180
# 1 = imprime en consola cada llamada al modelo
LLM_DEBUG=0
# Solo la usan los modelos sin razonamiento; gpt-5.x y gpt-6.x usan la de por defecto.
LLM_TEMPERATURA=0.2
# En los modelos de razonamiento este límite incluye lo que el modelo "piensa":
# con menos, una revisión larga puede cortarse antes de registrar los hallazgos.
LLM_MAX_TOKENS=16000
# Respaldo opcional (se usa si el principal falla, por ejemplo por cuota):
# LLM_2_BASE_URL, LLM_2_API_KEY, LLM_2_MODEL ... hasta LLM_9_*.
# Recomendado: gpt-5.4-mini (más barato, también con herramientas y razonamiento).
# LLM_2_BASE_URL=https://api.openai.com/v1
# LLM_2_API_KEY=
# LLM_2_MODEL=gpt-5.4-mini

# --- Embeddings (locales, se descargan la primera vez, ~200 MB) -------------
SENTENCE_TRANSFORMER_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2

# --- Base vectorial (Chroma persistente, la crea scripts/indexar.py) -------
CHROMA_DIR=chroma_db
CHROMA_COLECCION=lineamientos
CONOCIMIENTO_DIR=conocimiento

# --- Recuperación: top-k -> MMR -> fragmentos al prompt ---------------------
# Similitud mínima (coseno). Calibrado con conocimiento/preguntas_control.json:
# con granite, lo que está en tema da >= 0.83 y lo ajeno <= 0.82.
RAG_UMBRAL=0.79
RAG_K_INICIAL=8
RAG_K_FINAL=3
# 1.0 = solo relevancia · 0.0 = solo novedad · 0.5 = mitad y mitad
RAG_MMR_LAMBDA=0.5
CHUNK_MAX_PALABRAS=150
CHUNK_OVERLAP_PALABRAS=25

# --- Clasificador de preguntas frecuentes del proceso -----------------------
FAQ_UMBRAL=0.55
FAQ_MARGEN=0.03
FAQ_CONTEXTO_MIN=0.25

# --- Guardias de entrada ----------------------------------------------------
# JSON con proyectos confidenciales y expresiones bloqueadas
TERMINOS_PATH=app/seguridad/terminos_bloqueados.json

# --- Conversación y base de datos ------------------------------------------
DB_PATH=data/revisiones.db
MAX_MENSAJES=8
MAX_VUELTAS=6
LIMITE_MENSAJE=12000
DB_RETENCION_DIAS=90
INFORMES_DIR=data/informes
CASOS_DIR=casos_prueba

# --- Logs por turno (JSONL) -------------------------------------------------
LOG_DIR=data/logs
LOG_CONSOLA=1
LOG_NIVEL=INFO
LOG_ROTACION_MB=2
LLM_LENTO_MS=15000

# --- Red ---------------------------------------------------------------------
# 1 = usa los certificados de Windows/macOS para HTTPS (necesario si un
# antivirus o proxy inspecciona TLS). La verificación nunca se desactiva.
SSL_SISTEMA=1

# --- Servidor ---------------------------------------------------------------
PORT=8040
